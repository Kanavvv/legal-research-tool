{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://legal-research-tool-509320.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://legal-research-tool-509320.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/sitemap-shares.xml",
      "destination": "https://api.asknyaya.in/sitemap-shares.xml"
    },
    {
      "source": "/sitemap-content.xml",
      "destination": "https://api.asknyaya.in/sitemap-content.xml"
    },
    {
      "source": "/a/:id",
      "destination": "https://api.asknyaya.in/seo/a/:id"
    },
    {
      "source": "/explained/:slug",
      "destination": "https://api.asknyaya.in/seo/explained/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
